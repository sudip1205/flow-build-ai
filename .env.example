# Choose one provider: openai-compatible | anthropic | openai
LLM_PROVIDER=openai-compatible

# Used when LLM_PROVIDER=openai-compatible (Ollama, LM Studio, vLLM, LocalAI,
# OpenRouter, or your own self-hosted endpoint that speaks the
# OpenAI /chat/completions dialect)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1

# Only needed for anthropic / openai / hosted openai-compatible providers
LLM_API_KEY=

# The in-app "Model settings" panel lets visitors supply their own provider,
# base URL and key. Their base URL must be a public https host unless this is
# true (only enable it for a private deployment you trust).
ALLOW_PRIVATE_BASE_URL=false
